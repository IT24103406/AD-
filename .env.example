# MongoDB Connection URI (Atlas or local) — use a dedicated database per service
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/ridelink_account_db?retryWrites=true&w=majority

# JWT Configuration — MUST be the SAME value across all four services
JWT_SECRET=your_shared_jwt_secret_here_min_32_chars
JWT_EXPIRATION=86400000
