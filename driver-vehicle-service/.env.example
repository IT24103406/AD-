# MongoDB Connection URI (Atlas or local) — dedicated driver/vehicle database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/ridelink_driver_vehicle_db?retryWrites=true&w=majority

# Shared JWT Secret — MUST match Account Service exactly
JWT_SECRET=your_shared_jwt_secret_here_min_32_chars

# Account Service Base URL (local Mac defaults)
ACCOUNT_SERVICE_URL=http://localhost:8081
