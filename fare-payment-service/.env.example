# MongoDB Connection URI (Atlas or local) — dedicated fare/payment database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/ridelink_fare_payment_db?retryWrites=true&w=majority

# Shared JWT Secret — MUST match Account Service exactly
JWT_SECRET=your_shared_jwt_secret_here_min_32_chars

# Inter-service URLs (local Mac defaults)
RIDE_SERVICE_URL=http://localhost:8083
ACCOUNT_SERVICE_URL=http://localhost:8081

# Fare calculation rules (optional overrides)
FARE_BASE_FARE=150.00
FARE_PER_KM_RATE=80.00
FARE_PER_MINUTE_RATE=5.00
FARE_MINIMUM_FARE=250.00
