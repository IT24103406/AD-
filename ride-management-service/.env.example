# MongoDB Connection URI (Atlas or local) — dedicated ride database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/ridelink_ride_management_db?retryWrites=true&w=majority

# Shared JWT Secret — MUST match Account Service exactly
JWT_SECRET=your_shared_jwt_secret_here_min_32_chars

# Inter-service URLs (local Mac defaults)
ACCOUNT_SERVICE_URL=http://localhost:8081
DRIVER_SERVICE_URL=http://localhost:8082
FARE_PAYMENT_SERVICE_URL=http://localhost:8084
